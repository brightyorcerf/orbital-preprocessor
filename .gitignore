# --- Project Specific Artifacts ---
# Generated protobuf classes (as per your layout notes)
**/__pycache__/
**/*_pb2.py
**/*_pb2_grpc.py

# --- Packaging (pip install -e .) ---
*.egg-info/
build/
dist/

# --- Python Environment ---
.venv/
venv/
env/
*.pyc
*.pyo
*.pyd

# --- Data & Weights ---
# Prevents heavy model weights or datasets from being pushed
*.pth
*.onnx
*.weights
data/*.zip
data/*.csv
data/*.json
!data/__init__.py

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Tools & IDEs ---
.vscode/
.idea/
*.swp

# --- OSP Generated Datasets ---
osp_dataset/
osp_dataset_*/

# --- Training Runs (Ultralytics output) ---
runs/

# --- Model Artifacts (regenerate with satellite_export.py) ---
model/artifacts/
yolov8n_6ch.pt
yolov8n.pt

# --- Inference Output ---
/output/

# --- Proto generated (re-compile with compile_proto.sh) ---
# Uncommenting this will require running compile_proto.sh on every clone:
# inference/osp_pb2.py

# --- Scene Memory DB (runtime state, do not commit) ---
ground/osp_memory.db

# --- Misc ---
globe.html
*.npy
!ground/__init__.py
!model/__init__.py
!inference/__init__.py
*.data

